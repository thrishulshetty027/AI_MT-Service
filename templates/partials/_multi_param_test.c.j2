/* Multi-param test case: {{ tc.scenario_id }} — {{ tc.scenario }}
 * Params: {{ tc.inputs | length }} parameters
 */
{% for pname, pval in tc.inputs.items() %}
{% if pval is mapping %}
    {{ param_ctypes[pname] }} {{ pname }};
{% for fname, fval in pval.items() %}
    {{ pname }}.{{ fname }} = {{ fval }};
{% endfor %}
{% else %}
    {{ param_ctypes[pname] }} {{ pname }} = {{ pval }};
{% endif %}
{% endfor %}
{% if tc.return_type != "void" %}
    {{ tc.return_type }} result;
{% endif %}

{% if tc.return_type != "void" %}
    result = {{ tc.function_name }}({{ call_args | join(', ') }});
{% if is_float_return %}
    CHECK_DOUBLE({{ tc.expected_return }}, result, {{ tolerance }});
{% else %}
    CHECK_INT({{ tc.expected_return }}, result);
{% endif %}
{% else %}
    {{ tc.function_name }}({{ call_args | join(', ') }});
{% for out_name, out_val in tc.expected_output_params.items() %}
    CHECK_INT({{ out_val }}, {{ out_name }});
{% endfor %}
{% endif %}
