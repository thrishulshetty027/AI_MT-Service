/* Float test case: {{ tc.scenario_id }} — {{ tc.scenario }}
 * Return type: {{ tc.return_type }} (float/double)
 */
{% for pname, pval in tc.inputs.items() %}
    {{ param_ctypes[pname] }} {{ pname }} = {{ pval }};
{% endfor %}
    {{ tc.return_type }} result;

    result = {{ tc.function_name }}({{ call_args | join(', ') }});
    CHECK_DOUBLE({{ tc.expected_return }}, result, {{ tolerance }});
