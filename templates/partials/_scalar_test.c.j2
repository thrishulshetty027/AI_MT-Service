/* Scalar test case: {{ tc.scenario_id }} — {{ tc.scenario }}
 * Param: {{ param_name }} ({{ param_ctype }})
 */
{% for pname, pval in tc.inputs.items() %}
    {{ param_ctypes[pname] }} {{ pname }} = {{ pval }};
{% endfor %}
{% if tc.return_type != "void" %}
    {{ tc.return_type }} result;
{% endif %}

{% if tc.return_type != "void" %}
    result = {{ tc.function_name }}({{ call_args | join(', ') }});
    CHECK_INT({{ tc.expected_return }}, result);
{% else %}
    {{ tc.function_name }}({{ call_args | join(', ') }});
{% endif %}
