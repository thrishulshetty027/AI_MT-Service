/* Void return test case: {{ tc.scenario_id }} — {{ tc.scenario }}
 * Return type: void — check side effects
 */
{% for pname, pval in tc.inputs.items() %}
{% if pval is mapping %}
    {{ param_ctypes[pname] }} {{ pname }};
{% for fname, fval in pval.items() %}
    {{ pname }}.{{ fname }} = {{ fval }};
{% endfor %}
{% else %}
    {{ param_ctypes[pname] }} {{ pname }} = {{ pval }};
{% endif %}
{% endfor %}

    {{ tc.function_name }}({{ call_args | join(', ') }});

{% for out_name, out_val in tc.expected_output_params.items() %}
    CHECK_INT({{ out_val }}, {{ out_name }});
{% endfor %}
