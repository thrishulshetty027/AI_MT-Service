--- string_ops.c
+++ string_ops.c
@@ -1,5 +1,13 @@
-int concatenate(char* dest, char* src, int dest_size) {
-    return 0;
-}
+int concatenate(char* dest, char* src, int dest_size) {
+    int len = 0;
+    int i;
+    for(i = 0; src[i] != '\\0'; i++) {
+        if (len < dest_size - 1) {
+            dest[len] = src[i];
+            len++;
+        }
+    }
+    dest[len] = '\\0';
+    return len;
+}
