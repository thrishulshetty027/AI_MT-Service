+int sumPositive(int arr[], int size) {
+    int sum = 0;
+
+    for (int i = 0; i < size; i++) {
+        if (arr[i] > 0)
+            sum += arr[i];
+    }
+
+    return sum;
+}
+
+int countNegative(int arr[], int size) {
+    int count = 0;
+
+    for (int i = 0; i < size; i++) {
+        if (arr[i] < 0)
+            count++;
+    }
+
+    return count;
+}
+
+int firstZeroIndex(int arr[], int size) {
+    for (int i = 0; i < size; i++) {
+        if (arr[i] == 0)
+            return i;
+    }
+
+    return -1;
+}
